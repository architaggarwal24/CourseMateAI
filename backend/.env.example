# Required for local development
JWT_SECRET=
ENCRYPTION_KEY=

# Optional
ENABLE_OLLAMA=true               # local-only provider for development; set false in production
ALLOW_LOCAL_PROVIDERS=false      # true = OpenAI-compatible base URLs may be private/LAN addresses
# ALLOW_INSECURE_DEV_KEY=true     # only to migrate keys saved while ENCRYPTION_KEY was unset
# MAX_SESSIONS_PER_USER=10
ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_EXPIRY_HOURS=24
MAX_SESSIONS=100
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5     # model used to index AND search PDFs. Smaller local option: BAAI/bge-small-en-v1.5
#                                          # (changing it marks existing documents "needs_reindex": upload the file again)
INDEX_CONCURRENCY=2                      # PDFs indexed at the same time; the rest wait in the queue
# Retrieval. Relevance = cosine similarity (0..1) between the question and the best matching chunk. The best score
# of every chat question is logged ("chat best_similarity=..."), so tune these against your own documents.
# RELEVANCE_BLOCK_BELOW=0.30      # chat: below this -> 'I cannot find "..." in the uploaded PDF'
# RELEVANCE_CLARIFY_BELOW=0.45    # chat: below this -> answer, but ask the student to clarify
# TOPIC_MIN_SIMILARITY=0.40       # quiz / notes / flashcards: below this -> the topic isn't covered by the PDF
# RETRIEVAL_MMR_LAMBDA=0.7        # 1.0 = most relevant chunks only, 0.0 = most varied
# QUERY_REWRITE=true              # rewrite follow-up questions into standalone ones before searching (1 small LLM call)
# QUERY_REWRITE_TURNS=6           # how many of the latest messages the rewrite sees
# GENERATION_CACHE_TTL=3600       # seconds a generated quiz / flashcards / notes is reused for an identical request (0 = off)
# METRICS_ENABLED=false             # true = serve GET /metrics (LLM calls per provider: count, latency, error class). No login: keep the port private

# Plans and quotas (Phase 3 Stage 4a; docs/plans.md)
DEFAULT_TIER=apprentice          # the plan of every account without one of its own. Unset = archmage (dev: everything on)
INVITE_ONLY=1                    # sign-up needs an invite code (make them with: python scripts/admin.py invite create ...)
QUOTA_BYOK_EXEMPT=1              # calls on a user's OWN provider key don't count against the plan's AI quotas
PLAN_LIMITS_JSON={"apprentice": {"ai_calls_day": 40}}   # override any limit of any plan without a code change
GOOGLE_API_KEY=               # a server key makes "CourseMate's AI" available: accounts then need no key of their own
#NVIDIA_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Model routing, costs and the quiz bank (Phase 3 Stage 4b; docs/model-routing.md). Only for accounts on the
# server's own AI; a user's own key always answers with their own model. Each slot is "provider:model".
LLM_FAST=gemini:gemini-3.5-flash-lite       # cheap API model (default: the first server key, its default model)
LLM_STRONG=gemini:gemini-3.8-flash          # questions and answers (default: LLM_FAST)
LLM_PREMIUM=claude:claude-sonnet-5-5        # Archmage's first choice (default: LLM_STRONG)
LOCAL_LLM=ollama:nemotron-3-ultra:cloud                   # a model on this machine for small jobs (boss lines, follow-up rewrites)
LOCAL_LLM_BASE_URL=http://localhost:11434   # Ollama's default; LM Studio: openai-compatible:<model> + http://localhost:1234/v1
LOCAL_LLM_TIMEOUT=25                        # seconds before a slow local answer falls through to the API
MODEL_ROUTES_JSON={"apprentice": {"strong": ["local", "fast"]}}   # per plan and job: slots in order (first = best)
MODEL_PRICES_JSON={"gemini:gemini-3.8-flash": [IN, OUT], "claude:*": [IN, OUT]}   # USD per 1M tokens, from your provider's pricing page
#USD_TO_INR=                                 # optional: cost reports also in rupees
QUIZ_BANK=1                                 # 0 = never serve quiz questions from the per-document bank

# Payments (Phase 3 Stage 4c; docs/payments.md). Off unless PAYMENTS_ENABLED=1.
# PAYMENTS_ENABLED=0
# PAYMENTS_PROVIDER=stub                     # only for trying the flow: "pays" at once, no money. Leave unset for Razorpay
# RAZORPAY_KEY_ID=rzp_test_...               # Dashboard -> Account & Settings -> API keys (test mode first)
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...                # the secret you type when adding the webhook
# RAZORPAY_PLAN_IDS_JSON={"scholar:month": "plan_...", "scholar:year": "plan_...", "sage:month": "plan_...", "sage:year": "plan_...", "archmage:month": "plan_...", "archmage:year": "plan_..."}

# Error monitoring (Phase 3 Stage 4d; docs/security.md). Off unless SENTRY_DSN is set. No PII, no secrets are sent.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0        # 0.1 = a tenth of requests also send a performance trace

# Database (Phase 3 Stage 4e; docs/postgres.md). Unset = SQLite in data/coursemate.db.
DATABASE_URL=postgresql://coursemate:password@localhost:5432/coursemate

# Cloudflare Worker in front (Phase 4; docs/deploy-cloudflare.md): the same 32+ character value as the Worker's
# PROXY_SECRET, so the backend believes the student's address the Worker sends (rate limits stay per student).
#PROXY_SECRET=