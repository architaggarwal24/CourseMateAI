{
  "name": "coursemateai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quick": "vitest run --changed",
    "check": "tsc --noEmit && vitest run",
    "test:e2e": "playwright test",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@sentry/browser": "^10.78.0",
    "@tailwindcss/typography": "^0.5.20",
    "better-auth": "1.7.14",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.4",
    "hast-util-to-text": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "next": "^16.4.3",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "4.10.38",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "5.4.2",
    "unist-util-visit": "^5.2.0",
    "uqr": "0.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "workerd@1.20261023.1": true
  },
  "overrides": {
    "katex": "$katex",
    "postcss-selector-parser": "^6.1.5"
  }
}
