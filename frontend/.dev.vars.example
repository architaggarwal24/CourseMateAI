# Local settings for `npm run dev` / `npm run cf:preview` (copy to .dev.vars; never commit .dev.vars).
# In production these are set in the Cloudflare dashboard (Workers -> coursemateai -> Settings -> Variables).

# Accounts (Stage 4.1; docs/deploy-cloudflare.md "Accounts").
# 32+ random characters: signs sessions and encrypts two-step secrets. Never change it once people have accounts.
BETTER_AUTH_SECRET=
# Your own account: once its email is verified it is always the admin, on the top plan.
OWNER_EMAIL=
# Optional: Google sign-in (Google Cloud -> Credentials -> OAuth client ID, type Web application).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: the sender for verification / reset codes. Without an email service codes only go to the log.
# EMAIL_FROM=CourseMate <no-reply@your-domain>
# RESEND_API_KEY=
# PBKDF2 work for passwords: 20000 fits the free plan's CPU limit; raise to 100000 on Workers Paid.
# PASSWORD_HASH_ITERATIONS=20000

# The server's AI (Stage 4.3; docs/deploy-cloudflare.md "AI"). provider:model, providers gemini | openai | claude | nvidia.
# LLM_FAST=gemini:gemini-3.5-flash-lite
# LLM_STRONG=gemini:gemini-3.8-flash
# LLM_PREMIUM=claude:claude-sonnet-5-5
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Small jobs on Workers AI (default @cf/meta/llama-3.1-8b-instruct-fp8)
# WORKERS_AI_MODEL=
# US dollars per 1M tokens [in, out], from the providers' pricing pages; unpriced models are estimated at [1, 4]
# MODEL_PRICES_JSON={"gemini:gemini-3.5-flash-lite": [0.1, 0.4], "gemini:gemini-3.8-flash": [0.3, 2.5], "claude:*": [3, 15]}
# The daily cap on the server's AI spend (US dollars; Admin -> AI spend changes it): default 2
# AI_DAILY_CAP_USD=2

# Study tools (Stage 4.4). Quiz / flashcards / notes: below this similarity the topic is "not in your PDF".
# TOPIC_MIN_SIMILARITY=0.40
# Days a generated flashcard set or notes are reused for the same request (0 = off)
# GENERATION_CACHE_DAYS=7

# Payments (Stage 4.6; docs/payments.md). Off unless PAYMENTS_ENABLED is set: everyone stays on Free, the owner on Archmage.
# PAYMENTS_ENABLED=1
# Only for trying the flow locally: a fake provider that "pays" without money.
# PAYMENTS_PROVIDER=stub
# Razorpay (Dashboard -> Account & Settings -> API Keys / Webhooks)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# One Razorpay plan per tier and period you sell
# RAZORPAY_PLAN_IDS_JSON={"scholar:month": "plan_...", "scholar:year": "plan_...", "sage:month": "plan_..."}
