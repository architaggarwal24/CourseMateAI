# CourseMate on a VPS (docs/deploy-vps.md). Copy to deploy/vps/.env and fill in. Keep it private.

# ── the site ─────────────────────────────────────────────────────────────────────────────────────────────────
DOMAIN=study.example.com
ACME_EMAIL=you@example.com

# ── secrets: generate once and keep a copy somewhere safe (docs/deploy-vps.md shows the commands) ─────────────
JWT_SECRET=
ENCRYPTION_KEY=

# ── database: empty = SQLite in the "data" volume. PostgreSQL: start with --profile postgres and set both ──────
POSTGRES_PASSWORD=
DATABASE_URL=
# DATABASE_URL=postgresql://coursemate:<POSTGRES_PASSWORD>@postgres:5432/coursemate

# ── plans and testers (docs/plans.md) ───────────────────────────────────────────────────────────────────────
DEFAULT_TIER=apprentice
INVITE_ONLY=1

# ── the server's AI (docs/model-routing.md) ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_FAST=gemini:gemini-3.5-flash-lite
LLM_STRONG=gemini:gemini-3.8-flash
# LLM_PREMIUM=claude:claude-sonnet-5-5
ENABLE_OLLAMA=false
# MODEL_PRICES_JSON={"gemini:gemini-3.8-flash": [IN, OUT]}
# USD_TO_INR=

# ── documents: bge-small fits a small VPS (~130 MB model, CPU only) ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_CONCURRENCY=2
MAX_SESSIONS=2000
SESSION_EXPIRY_HOURS=168

# ── payments (docs/payments.md) ──────────────────────────────────────────────────────────────────────────────
PAYMENTS_ENABLED=0
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_IDS_JSON=

# ── error monitoring (docs/security.md) ─────────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

BACKUP_KEEP_DAYS=14
