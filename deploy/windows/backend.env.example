# CourseMate backend: testers on your PC through a Cloudflare Tunnel (docs/deploy-windows.md).
# setup.ps1 copies this to backend\.env and fills in JWT_SECRET and ENCRYPTION_KEY for you. Keep that file private.

# ── secrets (setup.ps1 generates them; never share or commit) ────────────────────────────────────────────────
JWT_SECRET=__GENERATED__
ENCRYPTION_KEY=__GENERATED__

# ── the public address ───────────────────────────────────────────────────────────────────────────────────────
# Your tunnel hostname. The login cookie is Secure (the tunnel is https) and only this origin may call the API.
ALLOWED_ORIGIN=https://study.example.com
COOKIE_SECURE=true

# ── who gets in, on what plan (docs/plans.md) ───────────────────────────────────────────────────────────────
DEFAULT_TIER=apprentice
INVITE_ONLY=1
# python scripts\admin.py invite create --tier sage --days 30 --uses 20 --note "first testers"

# ── the server's AI (docs/model-routing.md): testers need no key of their own ──────────────────────────────
GOOGLE_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_FAST=gemini:gemini-3.5-flash-lite
LLM_STRONG=gemini:gemini-3.8-flash
# LLM_PREMIUM=claude:claude-sonnet-5-5
# Ollama on this PC for small jobs (boss lines, follow-up rewrites); a slow or stopped Ollama falls back to the API.
LOCAL_LLM=ollama:qwen3:8b
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_TIMEOUT=25
# Users can't pick Ollama themselves (it is your PC's, not theirs); the server's LOCAL_LLM still uses it.
ENABLE_OLLAMA=false
# MODEL_PRICES_JSON={"gemini:gemini-3.8-flash": [IN, OUT]}     # USD per 1M tokens, from the pricing page
# USD_TO_INR=

# ── documents ───────────────────────────────────────────────────────────────────────────────────────────────
# bge-small: ~130 MB, quick on a CPU. (Changing the model later asks users to re-upload their PDFs.)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_CONCURRENCY=2
MAX_SESSIONS=500
SESSION_EXPIRY_HOURS=168

# ── payments (docs/payments.md): off until you have Razorpay keys ──────────────────────────────────────────
PAYMENTS_ENABLED=0

# ── error monitoring (docs/security.md): off without a DSN ──────────────────────────────────────────────────
# SENTRY_DSN=
SENTRY_ENVIRONMENT=pc-beta

# ── database: the SQLite file in backend\data (backup.ps1 copies it safely). PostgreSQL: docs/postgres.md ────
# DATABASE_URL=postgresql://coursemate:password@localhost:5432/coursemate

# While the app runs on Cloudflare Workers (Phase 4; docs/deploy-cloudflare.md): the same value as the Worker's
# PROXY_SECRET, and ALLOWED_ORIGIN set to the Worker's address (https://coursemate.<you>.workers.dev or your domain).
# PROXY_SECRET=
