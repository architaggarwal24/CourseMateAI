# CourseMate on a VPS (docs/deploy-vps.md). Caddy gets and renews the HTTPS certificate for {$DOMAIN} by itself.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 55MB
	}

	# The API (and its streamed answers / webhooks) goes straight to the backend; everything else to Next.js.
	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
			}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# www.example.com -> example.com (uncomment if you use www)
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
